#!/bin/sh
# inst/scripts/nle_verify.R of the installed EMC2: the shipped artefacts, then the cards given;
# with no argument, the DDMnle card and the RDM A = 0 card of the reference exports as well.
set -e
V=/opt/emc2/lib/EMC2/scripts/nle_verify.R
E=/opt/nle/handover/nle-methods/port/export
if [ "$#" -eq 0 ]; then
  exec Rscript "$V" "$E/ddm_sc_s1106_e245_weights.json" "$E/rdm_ss_base_s801_e271_weights.json"
fi
exec Rscript "$V" "$@"
