#!/bin/bash
#PBS -N crdm_net
#PBS -P tg53
#PBS -q normal
#PBS -l ncpus=48
#PBS -l mem=144GB
#PBS -l jobfs=10GB
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -l wd
# M6 2026-10-06: crdm_net_N400 (hybrid race, dt 0.0005 card, 500 reps) on EMC2 dev-nle 142bd497 (= aa66e11d). Submit from the cell directory.
export LD_PRELOAD=/apps/gcc/12.2.0/lib64/libstdc++.so.6
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
export OMP_DYNAMIC=FALSE MKL_DYNAMIC=FALSE OPENBLAS_DYNAMIC=NO
export KMP_INIT_AT_FORK=FALSE MKL_DISABLE_FAST_MM=1
export TMPDIR=/scratch/tg53/ajh575/tmp R_PROFILE_USER=/dev/null R_LIBS=$HOME/R/nle-lib
module purge
module load gcc/12.2.0 intel-compiler/2021.10.0 R/4.5.0
cd "$PBS_O_WORKDIR/bundle"
{ echo "Job $PBS_JOBID on $(hostname) at $(date)"; mkdir -p $TMPDIR; time Rscript run_aa66.R 400 500 FALSE 48; } > "../crdm_net_N400_aa66.log" 2>&1
