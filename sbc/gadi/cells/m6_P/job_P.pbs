#!/bin/bash
#PBS -N m6_P
#PBS -P tg53
#PBS -q normal
#PBS -l ncpus=12
#PBS -l mem=48GB
#PBS -l jobfs=10GB
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -l wd
# M6 2026-10-06: M6a's posterior shift P on Gadi. Submit from the m6_P root with
#   qsub -v FIRST=1,LAST=1,CORES=12 job_P.pbs        (FIRST..LAST: dataset indices; one ds_<i>.rds each)
export LD_PRELOAD=/apps/gcc/12.2.0/lib64/libstdc++.so.6
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
export OMP_DYNAMIC=FALSE MKL_DYNAMIC=FALSE OPENBLAS_DYNAMIC=NO
export KMP_INIT_AT_FORK=FALSE MKL_DISABLE_FAST_MM=1
export TMPDIR=/scratch/tg53/ajh575/tmp R_PROFILE_USER=/dev/null R_LIBS=$HOME/R/nle-lib
export R_MAKEVARS_USER=/scratch/tg53/ajh575/2026-10-01_gadi_dev-nle/Makevars.icpx
export M6_OUT=results M6_CPPCACHE=/scratch/tg53/ajh575/tmp/m6_P_cpp_$PBS_JOBID
module purge
module load gcc/12.2.0 intel-compiler/2021.10.0 R/4.5.0
mkdir -p $TMPDIR
cd "$PBS_O_WORKDIR"
{ echo "Job $PBS_JOBID on $(hostname) at $(date)"
  time Rscript sbc/malte_m6_P_gadi.R $FIRST $LAST $CORES dt0005=malte_crdm_aff_log_h2_k12_clip_100k_dt0.0005 \
       dt005=malte_crdm_aff_log_h2_k12_clip_100k_dt0.005 dt05=malte_crdm_aff_log_h2_k12_clip_100k_dt0.05
} > "m6_P_${FIRST}_${LAST}.log" 2>&1
